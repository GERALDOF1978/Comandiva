{
  "rewrites": [
    {
      "source": "/api/lookup-cep",
      "destination": "/api/index?route=lookup-cep"
    },
    {
      "source": "/api/delivery-route",
      "destination": "/api/index?route=delivery-route"
    },
    {
      "source": "/api/delivery-sheet",
      "destination": "/api/index?route=delivery-sheet"
    },
    {
      "source": "/master",
      "destination": "/"
    },
    {
      "source": "/master/",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/login/",
      "destination": "/"
    },
    {
      "source": "/cadastro",
      "destination": "/"
    },
    {
      "source": "/cadastro/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        }
      ]
    }
  ]
}
