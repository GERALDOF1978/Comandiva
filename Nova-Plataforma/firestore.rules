rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminPath() { return /databases/$(database)/documents/platformAdmins/$(request.auth.uid); }
    function isPlatformAdmin() { return signedIn() && exists(adminPath()) && get(adminPath()).data.active == true; }
    function memberPath(restaurantId) { return /databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid); }
    function isMember(restaurantId) { return signedIn() && exists(memberPath(restaurantId)) && get(memberPath(restaurantId)).data.active == true; }
    function role(restaurantId) { return get(memberPath(restaurantId)).data.role; }
    function isOwner(restaurantId) { return isMember(restaurantId) && role(restaurantId) == 'owner'; }
    function isManager(restaurantId) { return isMember(restaurantId) && role(restaurantId) in ['owner','manager']; }
    function hasModule(restaurantId, module) {
      return isMember(restaurantId) &&
        (role(restaurantId) == 'owner' || module in get(memberPath(restaurantId)).data.get('permissions', []));
    }
    function canReadOrders(restaurantId) {
      return hasModule(restaurantId, 'Pedidos') || hasModule(restaurantId, 'Cozinha') ||
        hasModule(restaurantId, 'PDV') || hasModule(restaurantId, 'Mesas e comandas') ||
        hasModule(restaurantId, 'Delivery') || hasModule(restaurantId, 'Entregadores') ||
        hasModule(restaurantId, 'Financeiro');
    }
    function restaurantActive(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.status == 'active';
    }

    // Índice privado de acesso. Só backend/Admin cria ou altera.
    match /userRestaurantAccess/{uid}/restaurants/{restaurantId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Master é separado. O app cliente não consegue se promover a administrador.
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /subscriptions/{restaurantId} {
      allow read: if isManager(restaurantId) || isPlatformAdmin();
      allow write: if false;
    }

    match /restaurantSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /restaurants/{restaurantId} {
      // Documento interno do tenant: nunca público.
      allow read: if isMember(restaurantId) || isPlatformAdmin();
      allow write: if false;

      // Vínculos e papéis são autoridade do backend/Master.
      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isOwner(restaurantId) || isPlatformAdmin();
        allow write: if false;
      }

      // Somente este documento contém dados destinados ao cardápio/site público.
      match /settings/{docId} {
        allow read: if isMember(restaurantId) || isPlatformAdmin() ||
          (docId == 'public' && resource.data.published == true && restaurantActive(restaurantId));
        allow write: if isManager(restaurantId) && hasModule(restaurantId, "Configurações");
      }

      match /categories/{id} {
        allow read: if isMember(restaurantId) || isPlatformAdmin() ||
          (resource.data.active == true && restaurantActive(restaurantId));
        allow create, update: if isManager(restaurantId) && hasModule(restaurantId, "Cardápio");
        allow delete: if isOwner(restaurantId);
      }

      // Rascunhos privados de pizzas: nunca expor ao cardápio público.
      match /pizzaDrafts/{id} {
        allow read: if hasModule(restaurantId, "Cardápio") || isPlatformAdmin();
        allow create, update: if isManager(restaurantId) && hasModule(restaurantId, "Cardápio");
        allow delete: if isOwner(restaurantId);
      }

      match /products/{id} {
        allow read: if isMember(restaurantId) || isPlatformAdmin() ||
          (resource.data.active == true && restaurantActive(restaurantId));
        allow create, update: if isManager(restaurantId) && hasModule(restaurantId, "Cardápio");
        allow delete: if isOwner(restaurantId);
      }

      match /promotions/{id} {
        allow read: if isMember(restaurantId) || isPlatformAdmin() ||
          (resource.data.active == true && restaurantActive(restaurantId));
        allow create, update: if isManager(restaurantId) && hasModule(restaurantId, "Promoções");
        allow delete: if isOwner(restaurantId);
      }

      match /deliveryAreas/{id} {
        allow read: if isMember(restaurantId) || isPlatformAdmin() ||
          (resource.data.active == true && restaurantActive(restaurantId));
        allow create, update: if isManager(restaurantId) && hasModule(restaurantId, "Delivery");
        allow delete: if isOwner(restaurantId);
      }

      match /deliveryRanges/{id} {
        allow read: if isMember(restaurantId) || isPlatformAdmin() ||
          (resource.data.active == true && restaurantActive(restaurantId));
        allow create, update: if isManager(restaurantId) && hasModule(restaurantId, "Delivery");
        allow delete: if isOwner(restaurantId);
      }

      // Criação e mutações sensíveis passam por API confiável.
      match /orders/{id} {
        allow read: if canReadOrders(restaurantId) || isPlatformAdmin();
        allow create, update, delete: if false;

        match /payments/{paymentId} {
          allow read: if hasModule(restaurantId, "Financeiro") || isPlatformAdmin();
          allow write: if false;
        }
      }

      match /tables/{id} {
        allow read: if hasModule(restaurantId, "Mesas e comandas") || isPlatformAdmin();
        allow create, update: if hasModule(restaurantId, "Mesas e comandas");
        allow delete: if isManager(restaurantId) && hasModule(restaurantId, "Mesas e comandas");
      }

      match /customers/{id} {
        allow read: if hasModule(restaurantId, "Clientes") || hasModule(restaurantId, "Pedidos") || isPlatformAdmin();
        allow create, update: if hasModule(restaurantId, "Clientes") || hasModule(restaurantId, "Pedidos");
        allow delete: if isManager(restaurantId) && hasModule(restaurantId, "Clientes");
      }

      match /notificationOutbox/{id} {
        allow read: if isManager(restaurantId) || isPlatformAdmin();
        allow write: if false;
      }

      match /audit/{id} {
        allow read: if isManager(restaurantId) || isPlatformAdmin();
        allow write: if false;
      }
    }

    match /paymentWebhookEvents/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}